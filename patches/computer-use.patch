+import Foundation
+
+// Pure policy, separately tested without Accessibility permissions or UI input.
+func permitsKeyboardTarget(hostPid: Int32, targetPid: Int32, hostIsActive: Bool,
+    belongsToObservedTree: Bool, bundleId: String?, executablePath: String?) -> Bool {
+    guard hostPid > 0, targetPid > 0, belongsToObservedTree else { return false }
+    if targetPid == hostPid { return true }
+    return hostIsActive
+        && bundleId == "com.apple.appkit.xpc.openAndSavePanelService"
+        && executablePath == "/System/Library/Frameworks/AppKit.framework/Versions/C/XPCServices/com.apple.appkit.xpc.openAndSavePanelService.xpc/Contents/MacOS/com.apple.appkit.xpc.openAndSavePanelService"
+}
