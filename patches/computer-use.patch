+// macOS hosts open/save panels in an AppKit XPC process. Never broadcast keys:
+// use only a focused element in the current, validated app-window snapshot.
+private func keyboardTargetPid(_ snapshot: ObservationSnapshot) throws -> pid_t {
+    let app = snapshot.app
+    // Remote AX proxies can report the host PID. Consult the system focus only
+    // when it names the exact same observed top-level window, never by PID alone.
+    if app.isActive,
+       let raw = axCopy(AXUIElementCreateSystemWide(), kAXFocusedUIElementAttribute as CFString) as AnyObject?,
+       CFGetTypeID(raw) == AXUIElementGetTypeID(), let observedWindow = snapshot.window {
+        let systemFocus = raw as! AXUIElement
+        let top = axCopy(systemFocus, kAXTopLevelUIElementAttribute as CFString) as AnyObject?
+            ?? axCopy(systemFocus, kAXWindowAttribute as CFString) as AnyObject?
+        if let top, CFGetTypeID(top) == AXUIElementGetTypeID() {
+            let systemWindow = top as! AXUIElement
+            let sameWindow = CFEqual(systemWindow, observedWindow)
+                || (windowNumber(systemWindow) != nil && windowNumber(systemWindow) == windowNumber(observedWindow))
+            var pid: pid_t = 0
+            if sameWindow, AXUIElementGetPid(systemFocus, &pid) == .success,
+               pid != app.processIdentifier {
+                let target = NSRunningApplication(processIdentifier: pid)
+                guard permitsKeyboardTarget(hostPid: app.processIdentifier, targetPid: pid,
+                    hostIsActive: true, belongsToObservedTree: sameWindow,
+                    bundleId: target?.bundleIdentifier, executablePath: target?.executableURL?.resolvingSymlinksInPath().path),
+                    axString(systemFocus, kAXRoleAttribute as CFString) != "AXSecureTextField",
+                    axString(systemFocus, kAXSubroleAttribute as CFString) != "AXSecureTextField" else {
+                    throw fail("COMPUTER_ACTION_BLOCKED", "system focus is not an approved file-panel target")
+                }
+                return pid
+            }
+        }
+    }
+    var focused = snapshot.elements.filter { axBool($0.element, kAXFocusedAttribute as CFString) == true }.map(\.element)
+    if let appFocus = focusedElement(app), snapshot.elements.contains(where: { CFEqual($0.element, appFocus) }) {
+        focused.append(appFocus)
+    }
+    var targets: [(AXUIElement, pid_t)] = []
+    for element in focused {
+        var pid: pid_t = 0
+        if AXUIElementGetPid(element, &pid) == .success, pid > 0 { targets.append((element, pid)) }
+    }
+    // Prefer the focused remote view over a host proxy marked focused as well.
+    let candidate = targets.first(where: { $0.1 != app.processIdentifier }) ?? targets.first
+    guard let (element, pid) = candidate else { return app.processIdentifier }
+    guard axString(element, kAXRoleAttribute as CFString) != "AXSecureTextField",
+          axString(element, kAXSubroleAttribute as CFString) != "AXSecureTextField" else {
+        throw fail("COMPUTER_ACTION_BLOCKED", "keyboard input into a secure field is blocked")
+    }
+    let target = NSRunningApplication(processIdentifier: pid)
+    guard permitsKeyboardTarget(hostPid: app.processIdentifier, targetPid: pid,
+        hostIsActive: app.isActive, belongsToObservedTree: true,
+        bundleId: target?.bundleIdentifier, executablePath: target?.executableURL?.resolvingSymlinksInPath().path) else {
+        throw fail("COMPUTER_ACTION_BLOCKED", "focused keyboard target is not the approved app or its system file panel")
+    }
+    return pid
 }
 
