+++ b/tests/keyboard-target-policy.swift
@@ -0,0 +1,20 @@
+import Foundation
+@main struct PolicyTests {
+ static func main() {
+ let b = "com.apple.appkit.xpc.openAndSavePanelService"
+ let p = "/System/Library/Frameworks/AppKit.framework/Versions/C/XPCServices/com.apple.appkit.xpc.openAndSavePanelService.xpc/Contents/MacOS/com.apple.appkit.xpc.openAndSavePanelService"
+ func check(_ host: Int32 = 1, _ target: Int32 = 2, _ active: Bool = true, _ observed: Bool = true, _ bundle: String? = nil, _ path: String? = nil) -> Bool {
+ permitsKeyboardTarget(hostPid: host, targetPid: target, hostIsActive: active, belongsToObservedTree: observed, bundleId: bundle, executablePath: path)
+ }
+ precondition(check(1,1))
+ precondition(check(1,2,true,true,b,p))
+ precondition(!check(1,2,false,true,b,p))
+ precondition(!check(1,2,true,false,b,p))
+ precondition(!check(1,2,true,true,"untrusted",p))
+ precondition(!check(1,2,true,true,b,"/tmp/" + b))
+ precondition(!check(0,2,true,true,b,p))
+ precondition(!check(1,0,true,true,b,p))
+ precondition(!check(1,2,true,true,nil,nil))
+ print("keyboard target policy: 9 checks passed")
+ }
+}
