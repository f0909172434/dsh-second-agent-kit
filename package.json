{
  "name": "dsh-second-agent-kit",
  "version": "0.1.4",
  "type": "module",
  "license": "MIT",
  "description": "Auditable second-agent safeguards and compatibility patches for DeepSeek Harness on macOS",
  "main": "./src/approval.mjs",
  "exports": {
    ".": "./src/approval.mjs",
    "./sandbox": "./src/sandbox.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./engram-upgrade": "./src/engram-upgrade.mjs"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "README.zh-TW.md",
    "scripts/check-engram-upgrade.mjs",
    "docs/ENGRAM-UPGRADE.md"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check:engram-upgrade": "node scripts/check-engram-upgrade.mjs",
    "test:engram": "node --test tests/acceptance/engram.test.mjs",
    "test:migration": "node --test tests/acceptance/migration.test.mjs",
    "test:engram:junit": "node --test --test-reporter=junit --test-reporter-destination=reports/engram-memory.xml tests/acceptance/engram.test.mjs",
    "verify:engram": "node scripts/verify-engram.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-sandbox-local": "0.1.5-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-agent": "0.1.5-rc.2",
    "@deepseek-ai/dsh-app-boot": "0.1.5-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.5-rc.2",
    "@deepseek-ai/dsh-sandbox-local": "0.1.5-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.5-rc.2",
    "@kenz1117/dsh-engram": "0.7.6",
    "honest-ci": "1.0.4",
    "js-yaml": "4.3.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/f0909172434/dsh-second-agent-kit.git"
  },
  "bin": {
    "dsh-engram-upgrade-check": "scripts/check-engram-upgrade.mjs"
  }
}
